---
import { getBlogPosts } from '../../../lib/microcms';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<Layout
  title={`${post.title} | emeraldblue Blog`}
  description={post.description ?? post.title}
  section=""
  type="article"
  image={post.image?.url}
  articleMeta={{
    publishedTime: post.pubDate,
    author: post.author,
  }}
>
  <article class="post">
    {post.image && (
      <div class="post-eyecatch">
        <img src={post.image.url} alt="" />
      </div>
    )}
    <div class="post-header">
      <a href="/blog/" class="back-link">&larr; ブログ一覧へ</a>
      <time datetime={post.pubDate}>
        {formatDate(post.pubDate)}{post.author && ` ・ ${post.author}`}
      </time>
      <h1>{post.title}</h1>
      {post.tags && post.tags.length > 0 && (
        <div class="tags">
          {post.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </div>
    <div class="post-body" set:html={post.body} />
  </article>
</Layout>

<script define:vars={{ postId: post.id }}>
  const READ_POSTS_KEY = 'eb_read_posts';
  try {
    const readPosts = JSON.parse(localStorage.getItem(READ_POSTS_KEY) ?? '[]');
    if (!readPosts.includes(postId)) {
      readPosts.push(postId);
      localStorage.setItem(READ_POSTS_KEY, JSON.stringify(readPosts));
    }
  } catch {
    // localStorage unavailable (private browsing, etc.)
  }
</script>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 24px 64px;
  }
  .post-eyecatch {
    margin: -56px -24px 32px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .post-eyecatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-header {
    margin-bottom: 32px;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 13px;
    color: var(--color-teal);
    text-decoration: none;
  }
  .post-header time {
    display: block;
    font-size: 12px;
    color: #9A9488;
    margin-bottom: 8px;
  }
  .post-header h1 {
    font-size: 28px;
    margin: 0;
    line-height: 1.4;
  }
  .tags {
    margin-top: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 11px;
    padding: 2px 10px;
    border: 1px solid var(--color-teal);
    color: var(--color-teal);
    border-radius: 999px;
  }
  .post-body {
    font-size: 15px;
    line-height: 2;
    color: #33423E;
  }
  .post-body :global(h2) {
    font-size: 20px;
    margin: 40px 0 16px;
  }
  .post-body :global(p) {
    margin: 0 0 20px;
  }
  .post-body :global(img) {
    width: 100%;
    border-radius: 12px;
    margin: 24px 0;
  }
  .post-body :global(a) {
    color: var(--color-teal);
  }
</style>
