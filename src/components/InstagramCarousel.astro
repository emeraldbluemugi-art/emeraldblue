---
interface Props {
  urls: string[];
}

const { urls } = Astro.props;
---

<div class="ig-carousel">
  {urls.map((url) => (
    <div class="ig-card">
      <blockquote class="instagram-media" data-instgrm-permalink={url} data-instgrm-version="14">
        <a href={url} target="_blank" rel="noopener">Instagramで見る</a>
      </blockquote>
    </div>
  ))}
</div>

<script>
  // Instagramの埋め込みスクリプトは重いので、ページ表示を止めないよう
  // 画面の近くまでスクロールされてから非同期で読み込む
  function loadInstagramEmbeds() {
    const w = window as any;
    if (w.instgrm?.Embeds) {
      w.instgrm.Embeds.process();
      return;
    }
    if (document.getElementById('ig-embed-script')) return;
    const s = document.createElement('script');
    s.id = 'ig-embed-script';
    s.async = true;
    s.src = 'https://www.instagram.com/embed.js';
    document.body.appendChild(s);
  }

  const carousels = document.querySelectorAll('.ig-carousel');
  if (carousels.length > 0) {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      loadInstagramEmbeds();
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            observer.disconnect();
            start();
          }
        },
        { rootMargin: '400px 0px' }
      );
      carousels.forEach((el) => observer.observe(el));
    }
    // 念のための保険：ページ表示が落ち着いた数秒後には必ず読み込む
    window.addEventListener('load', () => setTimeout(start, 4000));
  }
</script>

<style>
  .ig-carousel {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 4px 12px;
    -webkit-overflow-scrolling: touch;
  }
  .ig-carousel::-webkit-scrollbar {
    height: 6px;
  }
  .ig-carousel::-webkit-scrollbar-thumb {
    background: #D8D4CA;
    border-radius: 999px;
  }
  .ig-card {
    flex: 0 0 auto;
    width: 330px;
    max-width: 330px;
    overflow: hidden;
    scroll-snap-align: start;
    zoom: 0.65;
    /* 埋め込みが読み込まれる前から高さを確保して、レイアウトのガタつきを防ぐ */
    min-height: 636px;
    background: #fff;
    border-radius: 12px;
  }
  .ig-card :global(.instagram-media),
  .ig-card :global(iframe) {
    max-width: 100% !important;
    width: 100% !important;
  }
</style>
