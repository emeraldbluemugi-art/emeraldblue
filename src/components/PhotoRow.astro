---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
}

const {
  images,
  alt,
  class: className = '',
  widths = [200, 400],
  sizes = '150px',
} = Astro.props;
---

<div class={`photo-row ${className}`}>
  {images.map((image) => (
    <Image src={image} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  ))}
</div>

<style>
  .photo-row {
    display: flex;
    gap: 4px;
    width: 100%;
    height: 100%;
  }
  .photo-row :global(img) {
    flex: 1;
    min-width: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #F7F5F0;
    display: block;
  }
</style>
