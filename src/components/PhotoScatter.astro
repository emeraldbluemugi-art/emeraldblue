---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;

// Hand-placed so the cluster stays compact and doesn't span the
// full width of the page.
const layout = [
  { x: 4, y: 14, r: -8, s: 1 },
  { x: 16, y: 62, r: 6, s: 0.9 },
  { x: 28, y: 22, r: -4, s: 1 },
  { x: 40, y: 70, r: 9, s: 0.85 },
  { x: 50, y: 10, r: -10, s: 0.95 },
  { x: 62, y: 60, r: 5, s: 0.9 },
  { x: 74, y: 20, r: -6, s: 1 },
  { x: 86, y: 66, r: 8, s: 0.85 },
  { x: 96, y: 16, r: -5, s: 0.8 },
];
---

<div class="photo-scatter">
  {images.slice(0, layout.length).map((image, i) => (
    <div
      class="scatter-item"
      style={`--x:${layout[i].x}%; --y:${layout[i].y}%; --r:${layout[i].r}deg; --s:${layout[i].s};`}
    >
      <Image src={image} alt={alt} widths={[120, 240]} sizes="90px" loading="lazy" />
    </div>
  ))}
</div>

<style>
  .photo-scatter {
    position: relative;
    max-width: 620px;
    margin: 0 auto;
    height: 220px;
  }
  .scatter-item {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: calc(84px * var(--s));
    padding: 5px 5px 14px;
    background: white;
    border-radius: 4px;
    box-shadow: 0 3px 8px rgba(0,0,0,0.15);
    transform: translate(-50%, -50%) rotate(var(--r));
  }
  .scatter-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .photo-scatter {
      height: 170px;
    }
    .scatter-item {
      width: calc(56px * var(--s));
      padding: 4px 4px 10px;
    }
  }
</style>
