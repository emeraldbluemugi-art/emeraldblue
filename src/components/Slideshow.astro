---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  intervalMs?: number;
  class?: string;
  widths?: number[];
  sizes?: string;
}

const {
  images,
  alt,
  intervalMs = 6000,
  class: className = '',
  widths = [400, 800, 1200],
  sizes = '100vw',
} = Astro.props;
---

<div class={`slideshow ${className}`} data-interval={intervalMs}>
  {images.map((image, i) => (
    <Image
      src={image}
      alt={i === 0 ? alt : ''}
      class={`slide ${i === 0 ? 'is-active' : ''}`}
      widths={widths}
      sizes={sizes}
      loading={i === 0 ? 'eager' : 'lazy'}
    />
  ))}
</div>

<style>
  .slideshow {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .slide.is-active {
    opacity: 1;
  }
</style>

<script>
  function initSlideshows(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('.slideshow').forEach((el) => {
      if (el.dataset.slideshowInit) return;
      const slides = el.querySelectorAll<HTMLElement>('.slide');
      if (slides.length < 2) return;
      el.dataset.slideshowInit = 'true';
      const interval = Number(el.dataset.interval) || 6000;
      let current = 0;
      setInterval(() => {
        slides[current].classList.remove('is-active');
        current = (current + 1) % slides.length;
        slides[current].classList.add('is-active');
      }, interval);
    });
  }
  initSlideshows(document);
</script>
