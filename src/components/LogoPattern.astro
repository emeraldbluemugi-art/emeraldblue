---
import { Image } from 'astro:assets';
import logo1 from '../assets/logos/logo1.png';
import logo2 from '../assets/logos/logo2.png';

// Deterministic pseudo-random generator so the "natural" scatter
// stays the same across builds instead of reshuffling every time.
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20240609);
const COUNT = 30;

const tiles = Array.from({ length: COUNT }).map(() => {
  // Bias toward small "bubbles" with only a few large ones, like
  // real bubble clusters rising through water.
  const sizeRoll = rand();
  const s = 0.22 + Math.pow(sizeRoll, 2.2) * 1.05;
  return {
    x: rand() * 104 - 2,
    y: rand() * 100,
    r: rand() * 50 - 25,
    s,
    opacity: 0.35 + s * 0.5,
    logo: rand() > 0.5 ? 1 : 2,
  };
});
---

<div class="logo-pattern">
  {tiles.map((t) => (
    <Image
      src={t.logo === 1 ? logo1 : logo2}
      alt=""
      class="logo-tile"
      widths={[60, 120, 200]}
      sizes="80px"
      loading="lazy"
      style={`--x:${t.x.toFixed(1)}%; --y:${t.y.toFixed(1)}%; --r:${t.r.toFixed(1)}deg; --s:${t.s.toFixed(2)}; --o:${t.opacity.toFixed(2)};`}
    />
  ))}
</div>

<style>
  .logo-pattern {
    position: relative;
    height: 260px;
    overflow: hidden;
  }
  .logo-tile {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: calc(90px * var(--s));
    height: auto;
    opacity: var(--o);
    transform: translate(-50%, -50%) rotate(var(--r));
  }

  @media (max-width: 640px) {
    .logo-pattern {
      height: 190px;
    }
    .logo-tile {
      width: calc(64px * var(--s));
    }
  }
</style>
