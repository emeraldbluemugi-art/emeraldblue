---
interface Props {
  title: string;
  description?: string;
  lang?: 'ja' | 'en';
  section?: '' | 'marine' | 'upcycle' | 'creative';
  type?: 'website' | 'article';
  image?: string;
  articleMeta?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
  };
}
const {
  title,
  description = "徳島県牟岐町emeraldblue。マリンサービス・アップサイクル・撮影/映像制作を行っています。",
  lang = 'ja',
  section = '',
  type = 'website',
  image = '/og-image.jpg',
  articleMeta,
} = Astro.props;

const jaHref = section === '' ? '/' : `/${section}/`;
const enHref = section === '' ? '/en/' : `/en/${section}/`;
const home = lang === 'en' ? '/en/' : '/';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteImageURL = new URL(image, Astro.site);

const navJa = [
  { href: '/#services', label: '私たちのこと' },
  { href: '/marine/', label: 'マリンサービス' },
  { href: '/upcycle/', label: 'アップサイクル' },
  { href: '/creative/', label: '撮影・映像' },
  { href: '/blog/', label: 'ブログ' },
  { href: '/#contact', label: 'お問い合わせ' },
];
const navEn = [
  { href: '/en/#services', label: 'About Us' },
  { href: '/en/marine/', label: 'Marine Service' },
  { href: '/en/upcycle/', label: 'Upcycle' },
  { href: '/en/creative/', label: 'Photo & Video' },
  { href: '/blog/', label: 'Blog' },
  { href: '/en/#contact', label: 'Contact' },
];
const nav = lang === 'en' ? navEn : navJa;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">

  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="emeraldblue" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteImageURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImageURL} />
  {articleMeta && <meta property="article:published_time" content={articleMeta.publishedTime} />}
  {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
  {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "emeraldblue",
    "description": "徳島県牟岐町を拠点に、ダイビング・スノーケリングなどのマリンサービス、海洋プラスチックのアップサイクル体験、写真・動画撮影/広告運用を行っています。",
    "url": "https://emeraldblue.jp",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "牟岐町",
      "addressRegion": "徳島県",
      "addressCountry": "JP"
    },
    "areaServed": ["徳島県", "四国", "牟岐町"],
    "sameAs": [
      "https://www.instagram.com/emeraldblue_mugi/",
      "https://note.com/emerald_bluemugi"
    ]
  })} />
  {articleMeta && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": absoluteImageURL.toString(),
      "datePublished": articleMeta.publishedTime,
      "dateModified": articleMeta.modifiedTime ?? articleMeta.publishedTime,
      "url": canonicalURL.toString(),
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL.toString() },
      "author": { "@type": "Person", "name": articleMeta.author ?? "emeraldblue" },
      "publisher": {
        "@type": "Organization",
        "name": "emeraldblue",
        "logo": { "@type": "ImageObject", "url": new URL('/favicon.svg', Astro.site).toString() }
      }
    })} />
  )}
</head>
<body>
  <header class="site-header">
    <nav>
      <a href={home} class="logo">emeraldblue</a>
      <ul id="site-nav">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-right">
        <div class="lang-switch">
          <a href={jaHref} class={lang === 'ja' ? 'active' : ''}>JA</a>
          <a href={enHref} class={lang === 'en' ? 'active' : ''}>EN</a>
        </div>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  </header>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('site-nav');
    toggle?.addEventListener('click', () => {
      const isOpen = nav?.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });
  </script>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    {lang === 'en'
      ? <p>&copy; emeraldblue, Mugi, Tokushima, Japan</p>
      : <p>&copy; emeraldblue, 牟岐町, 徳島県</p>}
  </footer>
</body>
</html>

<style>
  :root {
    --color-teal: #17BEBB;
    --color-ink: #04342C;
    --color-cream: #F7F5F0;
    --font-jp: 'Noto Sans JP', sans-serif;
    --font-display: 'Poppins', sans-serif;
  }
  * { box-sizing: border-box; }
  ::selection {
    background: var(--color-teal);
    color: white;
  }
  body {
    margin: 0;
    font-family: var(--font-jp);
    color: var(--color-ink);
    background: var(--color-cream);
  }
  .site-header { background: var(--color-teal); }
  .site-header nav {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .site-header ul {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header a {
    color: var(--color-ink);
    text-decoration: none;
    font-size: 14px;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang-switch {
    display: flex;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    overflow: hidden;
  }
  .lang-switch a {
    padding: 4px 10px;
    font-size: 12px;
  }
  .lang-switch a.active {
    background: var(--color-ink);
    color: var(--color-cream);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
  }
  .site-footer {
    text-align: center;
    padding: 32px;
    font-size: 13px;
    color: var(--color-ink);
  }

  @media (max-width: 780px) {
    .site-header ul#site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      order: 3;
    }
    .site-header ul#site-nav.is-open {
      display: flex;
    }
    .site-header ul#site-nav li {
      border-top: 1px solid rgba(4, 52, 44, 0.15);
    }
    .site-header ul#site-nav a {
      display: block;
      padding: 12px 4px;
      font-size: 15px;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>
